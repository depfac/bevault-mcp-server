# =============================================================================
# bevault-mcp - Environment Configuration Sample
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Module toggles (at least one must be enabled)
# -----------------------------------------------------------------------------
METAVAULT_ENABLED=true
STATES_ENABLED=false

# -----------------------------------------------------------------------------
# MetaVault (required when METAVAULT_ENABLED=true — default deployment)
# -----------------------------------------------------------------------------
BEVAULT_BASE_URL=https://bevault.your.domain
REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# States (required when STATES_ENABLED=true)
# States requires OIDC — see OIDC section below.
# -----------------------------------------------------------------------------
# STATES_BASE_URL=https://states.your.domain

# -----------------------------------------------------------------------------
# States-only deployment example
# -----------------------------------------------------------------------------
# METAVAULT_ENABLED=false
# STATES_ENABLED=true
# STATES_BASE_URL=https://states.your.domain
# REQUEST_TIMEOUT_SECONDS=30
# (OIDC variables below are required)

# -----------------------------------------------------------------------------
# Server (optional)
# -----------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000

# -----------------------------------------------------------------------------
# OIDC Authentication (optional for MetaVault-only; required for States)
# If all four required variables are set, OIDC is enabled.
# Otherwise, clients must use the bevault-api-key header (MetaVault only).
# -----------------------------------------------------------------------------
# OIDC_CONFIG_URL=https://your-oidc-provider.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_BASE_URL=https://your-mcp-server.domain.com
# OIDC_AUDIENCE=
# OIDC_REDIRECT_PATH=
# OIDC_REQUIRED_SCOPES=openid,profile

# -----------------------------------------------------------------------------
# CORS (optional, required for browser-based OIDC clients)
# -----------------------------------------------------------------------------
# CORS_ORIGINS=https://your-web-app.domain.com

# -----------------------------------------------------------------------------
# Sentry (optional - unset or leave empty to disable)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_SERVER_NAME=bevault-mcp-prod
# SENTRY_DEFAULTTAGS__service=bevault-mcp

# -----------------------------------------------------------------------------
# OpenTelemetry (optional - unset or leave empty to disable)
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=bevault-mcp
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
